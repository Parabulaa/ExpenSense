{
  "expo": {
    "name": "ExpenSense",
    "slug": "ExpenSense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Branding/Logo_Mark.png",
    "scheme": "expensense",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.expensense.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#F5F2E8",
        "foregroundImage": "./assets/Branding/Logo_Mark.png",
        "monochromeImage": "./assets/Branding/Logo_Mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.expensense.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2E8",
          "image": "./assets/Branding/Logo_Mark.png",
          "imageWidth": 110
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        { "cameraPermission": "Allow ExpenSense to photograph receipts for expense recognition.", "recordAudioAndroid": false }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Allow ExpenSense to choose receipt images from your library." }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
