{
  "expo": {
    "name": "ExpenSense",
    "slug": "ExpenSense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Branding/Logo_Mark.png",
    "scheme": "expensense",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.expensense.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F2E8",
        "foregroundImage": "./assets/Branding/Logo_Mark.png",
        "monochromeImage": "./assets/Branding/Logo_Mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.expensense.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/Branding/Logo_Mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2E8",
          "image": "./assets/Branding/Logo_Mark.png",
          "imageWidth": 110
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ExpenSense to photograph receipts for expense recognition.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ExpenSense to choose receipt images from your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bb8181b-05b6-4571-bb59-4e93b843f8f2"
      }
    },
    "owner": "parabulaaa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bb8181b-05b6-4571-bb59-4e93b843f8f2"
    }
  }
}
